# ---------------------------------------------------------------------------
# Copy this file to `.env` and replace the placeholder values with your own.
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# `.env` is git-ignored — never commit real credentials.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by SQLAlchemy.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
SQLALCHEMY_URL="postgresql://postgres:postgres@localhost:5432/auth"

# Secret used to sign and verify JWTs.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="change-me-to-a-long-random-string"

# JWT signing algorithm (HS256 by default).
ALGORITHM="HS256"

# Access-token lifetime, in DAYS (loaded with float()).
ACCESS_TIME="30"
